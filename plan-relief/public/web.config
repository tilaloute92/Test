<?xml version="1.0" encoding="UTF-8"?>
<!--
  Configuration IIS pour "Plan Relief".

  Ce fichier est copié automatiquement dans le dossier `dist/` à chaque
  `npm run build` (tout ce qui est dans `public/` l'est). Déployez simplement
  le contenu de `dist/` tel quel sur le site IIS : ce fichier sera pris en
  compte automatiquement. Le script Install-PlanRelief.ps1 y ajoute ensuite la
  règle de relais /api vers le service local.

  Mêmes en-têtes de sécurité que Suivi Infra & Réseau, adaptés à cette application.
-->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <!--
          Taille maximale d'une requête : 110 Mo, pour laisser passer un plan de 100 Mo
          (valeur MAX_UPLOAD_MB du service) et l'enveloppe de l'envoi. IIS refuse par
          défaut au-delà de 30 Mo, ce qui bloquerait l'import des grands plans.
        -->
        <requestLimits maxAllowedContentLength="115343360" />
      </requestFiltering>
    </security>
    <staticContent>
      <!--
        Cache : le navigateur revérifie chaque fichier auprès du serveur (« no-cache » : il
        garde sa copie mais demande si elle a changé, réponse 304 si non). Sans cela, après
        une mise à jour, un poste peut continuer à faire tourner l'ancienne version de
        l'application pendant des jours. Le dossier assets/ (noms de fichiers changeant à
        chaque version) est, lui, gardé un an : voir la section <location> plus bas.
      -->
      <clientCache cacheControlMode="DisableCache" />
      <!-- Le worker de lecture PDF est un module .mjs : IIS ne le sert pas sans type déclaré. -->
      <remove fileExtension=".mjs" />
      <mimeMap fileExtension=".mjs" mimeType="text/javascript" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <!-- Modèle de langue de la lecture OCR (ocr/fra.traineddata.gz). -->
      <remove fileExtension=".gz" />
      <mimeMap fileExtension=".gz" mimeType="application/gzip" />
    </staticContent>
    <httpProtocol>
      <customHeaders>
        <!-- Empêche le site d'être affiché dans une <iframe> d'un autre site (anti-clickjacking). -->
        <add name="X-Frame-Options" value="DENY" />
        <!-- Empêche le navigateur de deviner le type d'un fichier autrement qu'annoncé par le serveur. -->
        <add name="X-Content-Type-Options" value="nosniff" />
        <!-- Limite les informations envoyées dans l'en-tête Referer vers d'autres sites. -->
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <!-- Désactive l'accès à des fonctionnalités du navigateur non utilisées par cette application. -->
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=(), payment=()" />
        <!--
          PAS de HSTS (max-age=0). Un navigateur applique HSTS au NOM du serveur, tous ports
          confondus : https://winas:8082 qui l'enverrait forcerait aussi http://winas:8080 et
          http://winas:8081 en HTTPS, et casserait les autres sites servis en clair sur le même
          serveur. max-age=0 efface la règle des navigateurs qui l'ont reçue d'une version
          précédente du site. Le site reste servi uniquement en HTTPS (aucune liaison http).
        -->
        <add name="Strict-Transport-Security" value="max-age=0" />
        <!--
          Content-Security-Policy : liste blanche de ce que la page a le droit de charger/exécuter.
          - script-src 'self'      : uniquement les scripts servis par ce site. Les bibliothèques
            (three.js, lecture DXF/PDF, OCR) et les polices sont intégrées au build : aucun CDN.
            'wasm-unsafe-eval' autorise uniquement la compilation du moteur OCR (WebAssembly servi
            par ce site, dossier ocr/) ; il n'autorise PAS eval() ni le JavaScript en ligne.
          - worker-src 'self' blob: : la lecture des PDF tourne dans un worker servi par ce site.
          - style-src 'unsafe-inline' : quelques styles en ligne dynamiques (couleur d'un calque,
            position de l'étiquette d'un équipement sur la vue 3D) — un risque bien moindre qu'un
            script en ligne, choix assumé et documenté comme pour Suivi Infra & Réseau.
          - img-src blob: data:    : capture de la vue 3D et aperçus générés dans la page.
          - connect-src            : ce site (API) et les domaines Microsoft nécessaires au SSO.
            Contrairement à Suivi Infra, pas de '*' : cette application n'appelle aucune API tierce.
        -->
        <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://login.microsoftonline.com https://*.microsoftonline.com https://*.msftauth.net https://*.msauth.net https://graph.microsoft.com; frame-src https://login.microsoftonline.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
