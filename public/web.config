<?xml version="1.0" encoding="UTF-8"?>
<!--
  Configuration IIS pour "Suivi Infra & Réseau".

  Ce fichier est copié automatiquement dans le dossier `dist/` à chaque
  `npm run build` (tout ce qui est dans `public/` l'est). Aucune étape
  manuelle n'est nécessaire : déployez simplement le contenu de `dist/`
  tel quel sur le site IIS, ce fichier sera pris en compte automatiquement.

  Il ajoute des en-têtes de sécurité HTTP recommandés à chaque réponse.
  Il ne nécessite aucun module IIS supplémentaire (la section
  httpProtocol/customHeaders fait partie du cœur d'IIS).
-->
<configuration>
  <system.webServer>
    <httpProtocol>
      <customHeaders>
        <!-- Empêche le site d'être affiché dans une <iframe> d'un autre site (anti-clickjacking). -->
        <add name="X-Frame-Options" value="DENY" />
        <!-- Empêche le navigateur de deviner le type d'un fichier autrement qu'annoncé par le serveur. -->
        <add name="X-Content-Type-Options" value="nosniff" />
        <!-- Limite les informations envoyées dans l'en-tête Referer vers d'autres sites. -->
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <!-- Désactive l'accès à des fonctionnalités du navigateur non utilisées par cette application. -->
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=(), payment=()" />
        <!--
          Force le navigateur à toujours utiliser HTTPS pour ce domaine pendant 1 an.
          NE LAISSEZ CETTE LIGNE QUE SI LE SITE EST BIEN SERVI EN HTTPS EN PERMANENCE
          (voir l'onglet Paramètres de l'application) : sinon, retirez-la tant que le
          certificat n'est pas en place, au risque de rendre le site inaccessible en HTTP.
        -->
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
        <!--
          Content-Security-Policy : liste blanche de ce que la page a le droit de charger/exécuter.
          Cette ligne est déjà adaptée à cette application :
          - script-src 'self'        : uniquement les scripts servis par ce site (l'appli ne charge
            et n'exécute aucun script en ligne ni externe).
          - style-src ... 'unsafe-inline' : nécessaire car deux éléments d'interface utilisent des
            styles en ligne dynamiques (couleur d'avatar par personne, barre de progression de charge)
            — un risque bien moindre qu'un script en ligne, c'est un choix assumé et documenté.
          - connect-src              : domaines que l'application peut appeler en réseau. Inclut les
            domaines Microsoft nécessaires à la connexion SSO (onglet Paramètres), et '*' pour laisser
            fonctionner l'onglet "Requêtes API" (qui appelle volontairement des applications tierces
            choisies par vous). Si vous n'utilisez pas cet onglet, remplacez '*' par la liste exacte
            de vos API internes pour restreindre davantage.
        -->
        <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://login.microsoftonline.com https://*.microsoftonline.com https://*.msftauth.net https://*.msauth.net https://graph.microsoft.com *; frame-ancestors 'none'" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
