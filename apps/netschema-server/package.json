{
  "name": "netschema-server",
  "private": true,
  "version": "1.0.0",
  "description": "Serveur NetSchema : authentification, schémas partagés, diffusion de l'application web.",
  "type": "module",
  "engines": { "node": ">=20.11" },
  "scripts": {
    "build": "tsc -b",
    "start": "node dist/index.js",
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "user": "node tools/netschema-user.mjs",
    "test": "node --test tools/tests/*.test.mjs"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.5",
    "@types/node": "^24.13.3",
    "typescript": "~6.0.2"
  }
}
