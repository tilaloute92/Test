# Configuration du service NetSchema (Windows)
# Copier en netschema.env à côté du service, puis adapter.
# Chaque ligne est NOM=valeur ; pas de guillemets autour des valeurs.

# ── Écoute ────────────────────────────────────────────────────────────────────
# 0.0.0.0 = toutes les cartes réseau du serveur. Mettre 127.0.0.1 si le service
# est publié derrière IIS sur la même machine.
NETSCHEMA_HOST=0.0.0.0
NETSCHEMA_PORT=8443

# ── HTTPS ─────────────────────────────────────────────────────────────────────
# Le plus simple : le certificat PFX exporté du magasin Windows, lu tel quel.
# Ces deux lignes sont renseignées automatiquement par Configurer-HTTPS.ps1.
# NETSCHEMA_TLS_PFX=C:\ProgramData\NetSchema\data\tls\netschema.pfx
# NETSCHEMA_TLS_PASSPHRASE=

# Variante : certificat et clé au format PEM (autorité Linux, Let's Encrypt…).
# NETSCHEMA_TLS_CERT=C:\ProgramData\NetSchema\data\tls\netschema.crt
# NETSCHEMA_TLS_KEY=C:\ProgramData\NetSchema\data\tls\netschema.key

# ── Emplacements ──────────────────────────────────────────────────────────────
# Données : comptes, schémas, journal d'audit. À sauvegarder.
NETSCHEMA_DATA_DIR=C:\ProgramData\NetSchema\data
# Interface web compilée (dossier dist de apps/netschema).
NETSCHEMA_WEB_DIR=C:\Apps\NetSchema\web

# ── Sécurité ──────────────────────────────────────────────────────────────────
# Secret de signature des sessions : 32 caractères minimum. S'il est absent, le
# service en tire un au hasard et le conserve dans le dossier de données.
# Générer : powershell -c "[Convert]::ToBase64String((1..48|%{Get-Random -Max 256}))"
# NETSCHEMA_SESSION_SECRET=

# Durée d'une session, en minutes (12 h par défaut).
NETSCHEMA_SESSION_MINUTES=720

# Derrière IIS / ARR : lire l'adresse réelle du client dans X-Forwarded-For.
NETSCHEMA_TRUST_PROXY=false
# Forcer les cookies « Secure » quand IIS termine le TLS à la place du service.
# NETSCHEMA_SECURE_COOKIES=true

# Tentatives de connexion par quart d'heure et par adresse.
NETSCHEMA_LOGIN_ATTEMPTS=10
# Échecs consécutifs avant blocage temporaire d'un compte, et durée du blocage.
NETSCHEMA_LOCK_AFTER_FAILURES=10
NETSCHEMA_LOCK_MINUTES=15

# Taille maximale d'un schéma envoyé (8 Mo par défaut).
NETSCHEMA_MAX_BODY_BYTES=8388608
