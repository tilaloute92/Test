<?xml version="1.0" encoding="utf-8"?>
<!--
  Publication de NetSchema derrière IIS.

  À utiliser quand le serveur doit répondre en 443 avec un certificat du magasin Windows, ou
  partager le port avec d'autres applications. IIS termine le TLS et relaie vers le service
  NetSchema, qui n'écoute alors que sur 127.0.0.1.

  Prérequis : modules « URL Rewrite » et « Application Request Routing » (ARR), puis dans la
  configuration d'ARR : Server Proxy Settings → Enable proxy.

  Côté service (netschema.env) :
      NETSCHEMA_HOST=127.0.0.1
      NETSCHEMA_PORT=8080
      NETSCHEMA_TRUST_PROXY=true
      NETSCHEMA_SECURE_COOKIES=true
      (et laisser NETSCHEMA_TLS_* commentés : c'est IIS qui porte le certificat)

  Rien à réécrire dans les réponses : c'est le service qui marque ses cookies « Secure » et
  qui pose les en-têtes de sécurité. Une règle sortante serait non seulement inutile, mais
  refusée par IIS sur des réponses compressées.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Tout est relayé au service local : interface web comme API. -->
        <rule name="NetSchema" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8080/{R:1}" />
        </rule>
      </rules>
    </rewrite>

    <security>
      <requestFiltering>
        <!-- Un schéma volumineux reste sous les 8 Mo acceptés par le service. -->
        <requestLimits maxAllowedContentLength="8388608" />
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <!-- IIS annonce sa version par défaut : inutile de la publier. -->
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
