<?xml version="1.0" encoding="utf-8"?>
<!--
  Publication de NetSchema derrière IIS.

  À utiliser quand le serveur doit répondre en 443 avec un certificat du magasin Windows,
  ou partager le port avec d'autres applications. IIS termine le TLS et relaie vers le
  service NetSchema, qui n'écoute alors que sur 127.0.0.1.

  Prérequis : « URL Rewrite » et « Application Request Routing » (ARR), puis dans la
  configuration d'ARR : Server Proxy Settings → Enable proxy.

  Côté service (netschema.env) :
      NETSCHEMA_HOST=127.0.0.1
      NETSCHEMA_PORT=8080
      NETSCHEMA_TRUST_PROXY=true
      NETSCHEMA_SECURE_COOKIES=true
      (et laisser NETSCHEMA_TLS_* commentés : c'est IIS qui porte le certificat)
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Tout est relayé au service local : interface web comme API. -->
        <rule name="NetSchema" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8080/{R:1}" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
        </rule>
      </rules>
      <outboundRules>
        <!-- Les cookies émis par le service restent valables tels quels ; on s'assure
             seulement qu'ils sont marqués Secure quand IIS termine le TLS. -->
        <rule name="CookiesSecure" preCondition="IsSetCookie">
          <match serverVariable="RESPONSE_Set_Cookie" pattern="(.*)(?&lt;!Secure)$" />
          <action type="Rewrite" value="{R:1}; Secure" />
        </rule>
        <preConditions>
          <preCondition name="IsSetCookie">
            <add input="{RESPONSE_Set_Cookie}" pattern="." />
          </preCondition>
        </preConditions>
      </outboundRules>
    </rewrite>

    <security>
      <requestFiltering>
        <!-- Un schéma volumineux reste sous les 8 Mo acceptés par le service. -->
        <requestLimits maxAllowedContentLength="8388608" />
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <!-- IIS annonce sa version par défaut : inutile de la publier. -->
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
